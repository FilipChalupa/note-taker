# ---- Public upload page (apps/intake) ----
PORT=8080
# Title shown on the page
INTAKE_TITLE=Note Taker
DEFAULT_LANGUAGE=cs

# Optional access code for uploaders. Share links as https://upload.example.com/?code=...
INTAKE_UPLOAD_CODE=

# Secret the internal web app uses to pull uploads (INTAKE_TOKEN there). Generate with: openssl rand -hex 32
INTAKE_COLLECT_TOKEN=
# Optional: serve the collector API on a separate port/interface (e.g. a VPN address) instead of the public port
COLLECT_PORT=
COLLECT_HOST=

# Limits
MAX_UPLOAD_MB=4096
MAX_PENDING_GB=20
CHUNK_MB=8
RATE_LIMIT_PER_HOUR=30
# Remove unfinished uploads after this many hours and uncollected recordings after this many days
UPLOAD_TTL_HOURS=24
READY_TTL_DAYS=14

# Set to 1 when running behind a reverse proxy that sets X-Forwarded-For (needed for per-IP limits)
TRUST_PROXY=0
