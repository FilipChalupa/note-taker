{
  "name": "@note-taker/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for Note Taker: agents can submit recordings and read transcripts with speaker annotations.",
  "type": "module",
  "bin": { "note-taker-mcp": "dist/index.js" },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
