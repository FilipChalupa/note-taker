# --- Server ---
WORKER_HOST=0.0.0.0
WORKER_PORT=8000
# Optional shared secret. If set, every request must send header `X-API-Key: <value>`.
WORKER_API_KEY=

# --- Models ---
# large-v3 (best quality, recommended for Czech; ~5 GB VRAM with int8_float16) or large-v3-turbo (~4x faster, less accurate)
WHISPER_MODEL=large-v3
# int8_float16 is the sweet spot for RTX 3080 12 GB. Alternatives: float16, int8
COMPUTE_TYPE=int8_float16
DEVICE=cuda
BATCH_SIZE=8
# Drop Whisper hallucinations (repeated short phrases, "subtitles by..." credits). 0 = keep everything.
HALLUCINATION_FILTER=1
# Default language when the request does not specify one. Empty = auto-detect.
DEFAULT_LANGUAGE=cs

# Loudness normalization during ffmpeg conversion: dynaudnorm (fast, default) | loudnorm (EBU R128, slower) | off
LOUDNESS_NORMALIZATION=dynaudnorm

# --- Diarization (pyannote) ---
# Hugging Face token with accepted terms for:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=
# Set to 0 to skip diarization entirely (all segments -> SPEAKER_00)
DIARIZATION_ENABLED=1
# pyannote pipeline. community-1 is the newest/most accurate; if its terms are not accepted the worker
# falls back to pyannote/speaker-diarization-3.1 automatically.
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1

# --- Multi-track files (OBS: mix, desktop audio, microphone as separate streams) ---
# auto = transcribe and diarize every stream with its own speech separately, skip the mix and silent or
# duplicate streams; off = default stream only, like a single-track file
MULTITRACK=auto
# Join speakers whose voices are at least this similar (one person split in two, or heard on two tracks).
# 0 = off
VOICE_MERGE_THRESHOLD=0.6

# --- Storage ---
# Where uploaded/normalized audio and results are kept
WORKER_DATA_DIR=./data
# Cache dir for Whisper / pyannote weights (defaults to ~/.cache/huggingface). Uncomment to override:
# HF_HOME=/path/to/models
# Delete finished tasks (files + results) older than this many hours. 0 = keep forever.
TASK_TTL_HOURS=72
