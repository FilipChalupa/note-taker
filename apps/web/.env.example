# Base URL of the GPU worker (apps/worker). From Docker on the homelab this is typically
# the LAN/Tailscale address of the Windows PC running WSL2, e.g. http://192.168.1.50:8000
WORKER_API_URL=http://localhost:8000
# Must match WORKER_API_KEY on the worker (leave empty if the worker has no key)
WORKER_API_KEY=

# Persistent storage (SQLite DB + uploaded/normalized audio). Mounted as a volume in Docker.
DATA_DIR=./data

# How often the server polls the worker for task progress (ms)
WORKER_POLL_INTERVAL_MS=3000
# Default transcription language offered in the upload form
DEFAULT_LANGUAGE=cs
# Reject uploads larger than this (MB)
MAX_UPLOAD_MB=2048
