# Base URL of the GPU worker (apps/worker). From Docker on the homelab this is typically
# the LAN/Tailscale address of the Windows PC running WSL2, e.g. http://192.168.1.50:8000
WORKER_API_URL=http://localhost:8000
# Must match WORKER_API_KEY on the worker (leave empty if the worker has no key)
WORKER_API_KEY=

# Persistent storage (SQLite DB + uploaded/normalized audio). Mounted as a volume in Docker.
DATA_DIR=./data

# How often the server polls the worker for task progress (ms)
WORKER_POLL_INTERVAL_MS=3000
# Default transcription language offered in the upload form
DEFAULT_LANGUAGE=cs
# Reject uploads larger than this (MB)
MAX_UPLOAD_MB=2048

# Watch folder: media files copied here are imported automatically (tagged "import"). Empty = disabled.
# In Docker the compose file mounts ./import to /data/import.
IMPORT_DIR=
IMPORT_LANGUAGE=cs

# Optional public upload page (apps/intake). The web app pulls finished uploads from it; the intake never connects
# into this network. Use the same value as INTAKE_COLLECT_TOKEN on the intake.
INTAKE_URL=
INTAKE_TOKEN=
INTAKE_POLL_SECONDS=30
# Tags given to recordings that arrive through the intake (comma-separated)
INTAKE_TAGS=intake
